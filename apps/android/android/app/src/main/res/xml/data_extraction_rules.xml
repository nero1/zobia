<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup/transfer scoping — ZB-AND-04 fix.

  CapacitorStorage.xml: the SharedPreferences file @capacitor/preferences
  writes to. Tokens no longer live here (see zobia_secure_tokens.xml below),
  but it still holds other locally-cached data worth keeping out of backups
  by default, so the exclusion stays.

  zobia_secure_tokens.xml: the EncryptedSharedPreferences file
  SecureTokenStorePlugin.java writes the JWT access token and refresh token
  to, encrypted with an Android Keystore-backed AES-256 key
  (JWT_KEY/REFRESH_TOKEN_KEY in src/lib/api/client.ts). Keystore keys are
  hardware-bound and are never included in a backup, so a restored copy of
  this file would be undecryptable garbage on any other device (or even a
  factory-reset same device, whose Keystore is wiped) — excluding it avoids
  that failing on every read and simply leaves the restored install logged
  out, same as before this file existed.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
        <exclude domain="sharedpref" path="zobia_secure_tokens.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
        <exclude domain="sharedpref" path="zobia_secure_tokens.xml" />
    </device-transfer>
</data-extraction-rules>
